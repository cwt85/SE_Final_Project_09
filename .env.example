# 複製這個檔案成 .env，再改成自己的密碼
# .env 不會被 commit（已列在 .gitignore）

# ---- docker-compose 使用 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ims
DB_PORT=5433
ADMINER_PORT=8080

# ---- FastAPI（db.py）使用 ----
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/ims
SESSION_SECRET=change-me-to-a-long-random-string
