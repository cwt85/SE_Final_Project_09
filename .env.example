# 複製這個檔案成 .env，再改成自己的密碼
# .env 不會被 commit（已列在 .gitignore）

# ---- docker-compose 使用 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ims
DB_PORT=5433
ADMINER_PORT=8080

# ---- FastAPI 使用 ----
# 本地模式：自己電腦的 Docker 資料庫（測試用）
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/ims
SESSION_SECRET=change-me-to-a-long-random-string

# 雲端模式：AWS 共用資料庫（資料會真的寫入，全組共用）
# 需先開 SSH 通道，詳見 README「雲端模式」；密碼請向組長索取，不要 commit
# 不設定的話，登入頁的「雲端模式」按鈕會無法選擇
# CLOUD_DATABASE_URL=postgresql://ims:向組長索取的密碼@localhost:5434/ims
